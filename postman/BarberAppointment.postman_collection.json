{
  "info": {
    "_postman_id": "barber-appointment-collection-v1",
    "name": "BarberAppointment API Collection",
    "description": "Kuaför Randevu Yönetim Sistemi REST API — Gün 13: Web ve Mobile İçin Tam Test Koleksiyonu",
