    {
      "name": "2. Services (Hizmet Yönetimi)",
      "item": [
        {
          "name": "Get All Services (Hizmet Listesi - Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/services?activeOnly=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services"],
