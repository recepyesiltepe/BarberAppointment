            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 4,\n  \"employeeId\": 1,\n  \"serviceId\": 1,\n  \"startAt\": \"2026-09-01T10:00:00\",\n  \"notes\": \"Postman Test Randevusu\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments"]
            }
          }
        },
